{
  "github": {
    "silent": true
  },
  "headers": [
    {
      "source": "/assets/(.*\\.(?:png|jpg|jpeg|gif|webp|ico|svg))",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*\\.(?:png|jpg|jpeg|gif|webp|ico|svg))",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/wechat_group.jpg",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate, max-age=0"
        }
      ]
    },
    {
      "source": "/qq_group.jpg",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate, max-age=0"
        }
      ]
    },
    {
      "source": "/sitemap.xml",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=300, s-maxage=300, stale-while-revalidate=1800"
        }
      ]
    },
    {
      "source": "/rss.xml",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=300, s-maxage=300, stale-while-revalidate=1800"
        }
      ]
    },
    {
      "source": "/robots.txt",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=300, s-maxage=300, stale-while-revalidate=1800"
        }
      ]
    },
    {
      "source": "/(.*\\.(?:woff|woff2|ttf|txt))",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=2592000"
        }
      ]
    },
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate, max-age=0"
        }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate, max-age=0"
        }
      ]
    },
    {
      "source": "/(.*\\.html)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate, max-age=0"
        }
      ]
    },
    {
      "source": "/console/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate, max-age=0"
        }
      ]
    },
    {
      "source": "/pricing/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate, max-age=0"
        }
      ]
    },
    {
      "source": "/contact/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate, max-age=0"
        }
      ]
    },
    {
      "source": "/status/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate, max-age=0"
        }
      ]
    },
    {
      "source": "/docs/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate, max-age=0"
        }
      ]
    },
    {
      "source": "/token/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate, max-age=0"
        }
      ]
    }
  ],
  "routes": [
    {
      "src": "^/api/?$",
      "dest": "https://api.nbility.dev/api"
    },
    {
      "src": "^/api/(.*)$",
      "dest": "https://api.nbility.dev/api/$1"
    },
    {
      "src": "^/v1/?$",
      "dest": "https://api.nbility.dev/v1"
    },
    {
      "src": "^/v1/(.*)$",
      "dest": "https://api.nbility.dev/v1/$1"
    },
    {
      "src": "^/v1beta/?$",
      "dest": "https://api.nbility.dev/v1beta"
    },
    {
      "src": "^/v1beta/(.*)$",
      "dest": "https://api.nbility.dev/v1beta/$1"
    },
    {
      "src": "^/mj/?$",
      "dest": "https://api.nbility.dev/mj"
    },
    {
      "src": "^/mj/(.*)$",
      "dest": "https://api.nbility.dev/mj/$1"
    },
    {
      "src": "^/pg/?$",
      "dest": "https://api.nbility.dev/pg"
    },
    {
      "src": "^/pg/(.*)$",
      "dest": "https://api.nbility.dev/pg/$1"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "^/(?!api(?:/|$)|v1(?:/|$)|v1beta(?:/|$)|mj(?:/|$)|pg(?:/|$)|assets(?:/|$)|.*\\..*).*$",
      "dest": "/index.html"
    }
  ]
}
