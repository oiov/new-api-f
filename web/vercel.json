{
  "github": {
    "silent": true
  },
  "headers": [
    {
      "source": "/assets/(.*\\.(?:png|jpg|jpeg|gif|webp|ico|svg))",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate, max-age=0"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*\\.(?:png|jpg|jpeg|gif|webp|ico|svg))",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate, max-age=0"
        }
      ]
    },
    {
      "source": "/(.*\\.(?:woff|woff2|ttf|txt))",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=2592000"
        }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    }
  ],
  "routes": [
    {
      "src": "^/api/?$",
      "dest": "https://claud.fishxcode.com/api"
    },
    {
      "src": "^/api/(.*)$",
      "dest": "https://claud.fishxcode.com/api/$1"
    },
    {
      "src": "^/v1/?$",
      "dest": "https://claud.fishxcode.com/v1"
    },
    {
      "src": "^/v1/(.*)$",
      "dest": "https://claud.fishxcode.com/v1/$1"
    },
    {
      "src": "^/v1beta/?$",
      "dest": "https://claud.fishxcode.com/v1beta"
    },
    {
      "src": "^/v1beta/(.*)$",
      "dest": "https://claud.fishxcode.com/v1beta/$1"
    },
    {
      "src": "^/mj/?$",
      "dest": "https://claud.fishxcode.com/mj"
    },
    {
      "src": "^/mj/(.*)$",
      "dest": "https://claud.fishxcode.com/mj/$1"
    },
    {
      "src": "^/pg/?$",
      "dest": "https://claud.fishxcode.com/pg"
    },
    {
      "src": "^/pg/(.*)$",
      "dest": "https://claud.fishxcode.com/pg/$1"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "^/(?!api(?:/|$)|v1(?:/|$)|v1beta(?:/|$)|mj(?:/|$)|pg(?:/|$)|assets(?:/|$)|.*\\..*).*$",
      "dest": "/index.html"
    }
  ]
}
