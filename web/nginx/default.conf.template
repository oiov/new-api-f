limit_req_zone $binary_remote_addr zone=api_limit:10m rate=80r/m;
limit_req_zone $binary_remote_addr zone=scan_limit:10m rate=10r/m;

server {
  listen 80;
  server_name _;

  root /usr/share/nginx/html;
  index index.html;

  gzip on;
  gzip_types
    text/plain
    text/css
    application/json
    application/javascript
    text/xml
    application/xml
    application/xml+rss
    image/svg+xml;

  location /assets/ {
    access_log off;
    expires 1y;
    add_header Cache-Control "public, immutable";
    try_files $uri =404;
  }

  location ~* ^/assets/.*\.(?:png|jpg|jpeg|gif|webp|ico|svg)$ {
    access_log off;
    expires off;
    add_header Cache-Control "no-store, no-cache, must-revalidate, max-age=0";
    try_files $uri =404;
  }

  location = /index.html {
    add_header Cache-Control "no-store, no-cache, must-revalidate, max-age=0";
  }

  location ~* \.html$ {
    add_header Cache-Control "no-store, no-cache, must-revalidate, max-age=0";
  }

  location ~* \.(?:png|jpg|jpeg|gif|webp|ico|svg)$ {
    access_log off;
    expires off;
    add_header Cache-Control "no-store, no-cache, must-revalidate, max-age=0";
    try_files $uri =404;
  }

  location ~* \.(?:woff|woff2|ttf|txt)$ {
    access_log off;
    expires 30d;
    add_header Cache-Control "public, max-age=2592000";
    try_files $uri =404;
  }

  location ~* ^/(admin|administrator|manage|cpanel|webadmin|adminer|phpmyadmin|pma|wp-admin|wp_admin)(?:/|$) {
    limit_req zone=scan_limit;
    default_type text/plain;
    return 200 "hello hack\n";
  }

  location ~* ^/(wp-login\.php|wp_login\.php|xmlrpc\.php|\.env|\.env\.local|\.env\.production|server-status|graphql)$ {
    limit_req zone=scan_limit;
    default_type text/plain;
    return 200 "hello hack\n";
  }

  location ~* ^/(\.git|\.svn|\.hg)(?:/|$) {
    limit_req zone=scan_limit;
    default_type text/plain;
    return 200 "hello hack\n";
  }

  location ~ ^/(api|v1|v1beta|mj|pg)(/.*)?$ {
    limit_req zone=api_limit;
    proxy_pass ${BACKEND_ORIGIN};
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Host $host;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header Connection "";
    proxy_buffering off;
    proxy_request_buffering off;
    proxy_read_timeout 3600s;
    proxy_send_timeout 3600s;
  }

  location / {
    add_header Cache-Control "no-store, no-cache, must-revalidate, max-age=0";
    try_files $uri $uri/ /index.html;
  }
}
