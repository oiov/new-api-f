# Backend origin — SERVER-SIDE ONLY, never sent to the browser.
# Used by: App Router proxy (/api/*) and next.config.ts rewrites (/v1/* /pg/* /mj/*).
# Do NOT prefix with NEXT_PUBLIC_ — that would expose the origin in the client bundle.
API_BASE_URL=https://api.fishxcode.com

# Site metadata
NEXT_PUBLIC_SITE_NAME=FishXCode
NEXT_PUBLIC_SITE_URL=https://www.fishxcode.com
